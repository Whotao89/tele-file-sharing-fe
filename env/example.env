### Telegram Bot ###
TELEGRAM_BOT_TOKEN=YOUR_TOKEN

### Backend API Base ###
# Vi du: https://yourdomain.com/api
BE_API_BASE=https://your_backend/api

### Webhook Config ###
USE_WEBHOOK=false
WEBHOOK_URL=https://yourdomain.com/webhook
PORT=YOUR_PORT

### Optional but recommended ###
# Timeout cho request toi backend
API_TIMEOUT=10

# Kich hoat debug mode
DEBUG=false

# Local path de luu file tam thoi
TEMP_DIR=/tmp/bot

# NNeu bot phai truy cap file server rieng
FILE_BASE_URL=https://your_backend/static
